---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { categoriesFor } from "@/utils/categories";
import { getPostPath, getTranslation } from "@/utils/translations";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import Datetime from "./Datetime.astro";
import PostCover from "./PostCover.astro";

export interface Props {
  post: CollectionEntry<"blog">;
  /** "row" : vignette à gauche (listes) — "grid" : vignette au-dessus (accueil). */
  layout?: "row" | "grid";
  /** Niveau du titre selon la hiérarchie de la page. */
  variant?: "h2" | "h3";
}

const { post, layout = "row", variant = "h2" } = Astro.props;
const { data } = post;

// Langue de la page (libellés, dates) — le post peut être dans l'autre langue
const uiLang = getLangFromUrl(Astro.url);
const t = useTranslations(uiLang);
const CATEGORIES = categoriesFor(uiLang);

const {
  title,
  description,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  category,
  lang,
  github,
  huggingface,
  kaggle,
  demo,
} = data;

const { remarkPluginFrontmatter } = await render(post);
const readingTime = remarkPluginFrontmatter?.readingTime as number | undefined;

const translation = getTranslation(post, await getCollection("blog"));

const projectLinks = [
  { label: "GitHub", href: github },
  { label: "Hugging Face", href: huggingface },
  { label: "Kaggle", href: kaggle },
  { label: t("post.demo"), href: demo },
].filter((l): l is { label: string; href: string } => Boolean(l.href));

const Heading = variant;
const isGrid = layout === "grid";
---

<li
  data-category={category}
  class:list={[
    "group relative",
    isGrid
      ? "flex flex-col"
      : "grid gap-4 border-b border-border py-6 first:pt-2 sm:grid-cols-[13rem_1fr] sm:gap-6",
  ]}
>
  <div
    class="aspect-video overflow-hidden rounded-md border border-border bg-muted"
  >
    <PostCover
      {post}
      widths={[320, 480, 720]}
      sizes={isGrid
        ? "(min-width: 768px) 368px, (min-width: 640px) 50vw, 100vw"
        : "(min-width: 640px) 208px, 100vw"}
      class="size-full transition-transform duration-500 group-hover:scale-[1.02]"
    />
  </div>

  <div class:list={["flex min-w-0 flex-col", { "flex-1 pt-3": isGrid }]}>
    <p
      class="flex flex-wrap items-center gap-x-2 text-xs font-semibold tracking-wide uppercase"
    >
      <span class="text-accent">{CATEGORIES[category].label}</span>
      <span class="text-border" aria-hidden="true">|</span>
      <span
        class="text-muted-foreground"
        title={useTranslations(lang)("post.writtenIn")}
      >
        {lang}
      </span>
      {
        translation && (
          <a
            href={getPostPath(translation)}
            hreflang={translation.data.lang}
            class="relative z-10 text-muted-foreground underline underline-offset-2 hover:text-accent"
            title={
              translation.data.lang === "en"
                ? "Read in English"
                : "Lire en français"
            }
          >
            {translation.data.lang}
          </a>
        )
      }
    </p>

    <Heading
      class="mt-1.5 text-lg leading-snug font-semibold tracking-tight"
      style={{ viewTransitionName: slugifyStr(title) }}
    >
      <a
        href={getPostPath(post)}
        class="transition-colors group-hover:text-accent after:absolute after:inset-0 after:content-['']"
      >
        {title}
      </a>
    </Heading>

    <p
      class:list={[
        "mt-1.5 text-[0.95rem] leading-relaxed text-muted-foreground",
        isGrid ? "line-clamp-2" : "line-clamp-3",
      ]}
    >
      {description}
    </p>

    {
      !isGrid && tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {tags.slice(0, 4).map(tag => (
            <li class="rounded border border-border px-1.5 py-0.5 text-[0.7rem] tracking-wide text-muted-foreground uppercase">
              {tag}
            </li>
          ))}
        </ul>
      )
    }

    <div
      class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-2 pt-3 text-xs text-muted-foreground"
    >
      <Datetime
        {pubDatetime}
        {modDatetime}
        {timezone}
        lang={uiLang}
        size="xs"
      />
      {readingTime && <span>· {readingTime} min</span>}
      {
        projectLinks.length > 0 && (
          <span class="relative z-10 ms-auto flex flex-wrap gap-3">
            {projectLinks.map(link => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-muted-foreground transition-colors hover:text-accent"
              >
                {link.label}
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </span>
        )
      }
    </div>
  </div>
</li>
