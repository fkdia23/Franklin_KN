---
import Wordmark from "./Wordmark.astro";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { KNOWLEDGE } from "@/knowledge.config";
import { getTracks, hubUrl, trackUrl } from "@/utils/knowledge";
import { LANG_NAMES } from "@/i18n/ui";
import {
  LANGS,
  getLangFromUrl,
  localizePath,
  otherLang,
  useTranslations,
} from "@/i18n/utils";

export interface Props {
  /**
   * Page équivalente dans l'autre langue. Par défaut : le même chemin avec
   * l'autre préfixe (/about/ ↔ /en/about/). Un post sans traduction passe
   * ici la liste des posts de l'autre langue.
   */
  alternate?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const switchHref =
  Astro.props.alternate ?? localizePath(Astro.url.pathname, otherLang(lang));

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

// Actif sur la page elle-même et ses sous-pages (/posts/…, /knowledge/<track>/…)
const isActive = (path: string) => {
  const target = path.replace(/\/+$/, "");
  return currentPath === target || currentPath.startsWith(`${target}/`);
};

// Onglets des tracks du Knowledge Hub, générés depuis src/knowledge.config.ts.
// Au-delà de KNOWLEDGE.headerLimit, « Plus » mène au hub qui les liste tous.
const tracks = getTracks();
const shownTracks = tracks.slice(0, KNOWLEDGE.headerLimit);
const hiddenTracks = tracks.slice(KNOWLEDGE.headerLimit);

const links = [
  { href: localizePath("/posts/", lang), label: t("nav.posts") },
  ...shownTracks.map(track => ({
    href: trackUrl(track, lang),
    label: track.title,
    // Dev uniquement : track désactivé, absent en production
    offline: !track.enabled,
  })),
  ...(hiddenTracks.length
    ? [
        {
          href: hubUrl(lang),
          label: t("nav.more"),
          title: hiddenTracks.map(track => track.title).join(", "),
          active: hiddenTracks.some(track => isActive(trackUrl(track, lang))),
        },
      ]
    : []),
  { href: localizePath("/tags/", lang), label: t("nav.tags") },
  { href: localizePath("/about/", lang), label: t("nav.about") },
] as {
  href: string;
  label: string;
  offline?: boolean;
  title?: string;
  active?: boolean;
}[];

const searchHref = localizePath("/search/", lang);
const archivesHref = localizePath("/archives/", lang);

const iconButton =
  "flex size-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted hover:text-foreground [&>svg]:size-[1.15rem] [&>svg]:stroke-[1.75]";
const scrollButton =
  "absolute top-1 z-10 flex size-7 items-center justify-center rounded-full border border-border bg-background text-muted-foreground shadow-sm transition-colors hover:text-foreground [&>svg]:size-4";
---

<!--
  Header centré sur la colonne du contenu (comme sebastianraschka.com) :
  1. [Franklin KN]  [réseaux]  |  [thème recherche archives]  [FR | EN]
  2. [Posts  <tracks…>  Tags  À propos]
  Quand les onglets dépassent, ils défilent : un fondu et une flèche signalent
  ceux qui sont cachés (clic = défilement). Sur mobile, les réseaux passent
  dans le pied de page. Le bouton de thème reste unique : toggle-theme.js
  cible #theme-btn.
-->
<header class="border-b border-border">
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-16 -top-full z-50 rounded-md bg-background px-3 py-2 text-accent shadow transition-all focus:top-4"
  >
    {t("nav.skip")}
  </a>

  <div class="mx-auto max-w-app px-4 pt-4">
    <div class="flex items-center gap-x-2">
      <a
        href={localizePath("/", lang)}
        class="py-1 text-[1.45rem] leading-none font-normal tracking-[-0.03em] whitespace-nowrap sm:text-[1.625rem]"
        aria-label={`${SITE.title}, ${t("site.home")}`}
      >
        <Wordmark />
      </a>

      <ul
        class="ms-2 hidden items-center gap-0.5 sm:flex"
        aria-label={t("nav.socials")}
      >
        {
          SOCIALS.map(social => (
            <li>
              <a
                href={social.href}
                class={iconButton}
                title={social.linkTitle}
                aria-label={social.linkTitle}
                {...(social.href.startsWith("http") && {
                  target: "_blank",
                  rel: "noopener noreferrer",
                })}
              >
                <social.icon />
              </a>
            </li>
          ))
        }
      </ul>
      <span class="mx-1 hidden h-5 w-px bg-border sm:block" aria-hidden="true"
      ></span>

      <div class="ms-auto flex items-center gap-0.5 sm:ms-0">
        {
          SITE.lightAndDarkMode && (
            <button
              id="theme-btn"
              class:list={[iconButton, "relative"]}
              title={t("nav.theme")}
              aria-label="auto"
              aria-live="polite"
            >
              <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
              <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
            </button>
          )
        }
        <a
          href={searchHref}
          class:list={[iconButton, { "text-foreground": isActive(searchHref) }]}
          aria-label={t("nav.search")}
          title={t("nav.search")}
        >
          <IconSearch />
        </a>
        {
          SITE.showArchives && (
            <a
              href={archivesHref}
              class:list={[
                iconButton,
                { "text-foreground": isActive(archivesHref) },
              ]}
              aria-label={t("nav.archives")}
              title={t("nav.archives")}
            >
              <IconArchive />
            </a>
          )
        }

        <!-- Langue : la page équivalente dans l'autre langue -->
        <ul
          class="ms-1.5 flex items-center rounded-md border border-border p-0.5 text-xs font-semibold"
          aria-label={t("nav.language")}
        >
          {
            LANGS.map(code => (
              <li>
                {code === lang ? (
                  <span
                    class="block rounded bg-muted px-1.5 py-0.5 text-foreground uppercase"
                    aria-current="true"
                    title={LANG_NAMES[code]}
                  >
                    {code}
                  </span>
                ) : (
                  <a
                    href={switchHref}
                    hreflang={code}
                    lang={code}
                    title={LANG_NAMES[code]}
                    class="block rounded px-1.5 py-0.5 text-muted-foreground uppercase transition-colors hover:text-foreground"
                  >
                    {code}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="relative">
      <button
        type="button"
        data-nav-prev
        hidden
        class:list={[scrollButton, "start-0"]}
        aria-label={t("nav.prevTabs")}
        title={t("nav.prevTabs")}
      >
        <IconChevronLeft />
      </button>
      <nav
        id="nav-menu"
        aria-label={t("nav.main")}
        class="nav-scroll -mx-1 mt-1 overflow-x-auto"
        data-nav-scroll
      >
        <ul
          class="flex w-max items-center gap-x-5 px-1 pt-1.5 pb-3 text-[0.95rem]"
        >
          {
            links.map(link => {
              const active = link.active ?? isActive(link.href);
              return (
                <li>
                  <a
                    href={link.href}
                    title={link.offline ? t("nav.offline") : link.title}
                    class:list={[
                      "font-medium whitespace-nowrap text-muted-foreground transition-colors hover:text-foreground",
                      { "active-nav": active, "opacity-50": link.offline },
                    ]}
                    aria-current={active ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      <button
        type="button"
        data-nav-next
        hidden
        class:list={[scrollButton, "end-0"]}
        aria-label={t("nav.nextTabs")}
        title={t("nav.nextTabs")}
      >
        <IconChevronRight />
      </button>
    </div>
  </div>
</header>

<script>
  /**
   * Onglets défilants : quand des onglets sont cachés, un fondu et une flèche
   * les signalent de ce côté ; la flèche fait défiler. L'onglet actif est
   * ramené au centre au chargement.
   */
  function setupNavScroll() {
    const nav = document.querySelector<HTMLElement>("[data-nav-scroll]");
    if (!nav) return;
    const prev = document.querySelector<HTMLButtonElement>("[data-nav-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-nav-next]");

    const update = () => {
      const max = nav.scrollWidth - nav.clientWidth;
      const hasLeft = nav.scrollLeft > 2;
      const hasRight = nav.scrollLeft < max - 2;
      nav.dataset.fade = [hasLeft && "left", hasRight && "right"]
        .filter(Boolean)
        .join(" ");
      if (prev) prev.hidden = !hasLeft;
      if (next) next.hidden = !hasRight;
    };

    const active = nav.querySelector<HTMLElement>('[aria-current="page"]');
    if (active && nav.scrollWidth > nav.clientWidth) {
      nav.scrollLeft =
        active.offsetLeft - (nav.clientWidth - active.offsetWidth) / 2;
    }
    update();

    // Écouteurs retirés à la navigation suivante (le header est remplacé)
    const controller = new AbortController();
    const { signal } = controller;
    const step = () => Math.max(120, nav.clientWidth * 0.6);
    prev?.addEventListener(
      "click",
      () => nav.scrollBy({ left: -step(), behavior: "smooth" }),
      { signal }
    );
    next?.addEventListener(
      "click",
      () => nav.scrollBy({ left: step(), behavior: "smooth" }),
      { signal }
    );
    nav.addEventListener("scroll", update, { passive: true, signal });
    window.addEventListener("resize", update, { passive: true, signal });
    document.addEventListener("astro:before-swap", () => controller.abort(), {
      once: true,
      signal,
    });
  }

  document.addEventListener("astro:page-load", setupNavScroll);
</script>
