---
import IconHash from "@/assets/icons/IconHash.svg";
import { getLangFromUrl, localizePath } from "@/i18n/utils";

export interface Props {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
}

const { tag, tagName, size = "sm" } = Astro.props;
const href = localizePath(`/tags/${tag}/`, getLangFromUrl(Astro.url));
---

<li
  class:list={[
    "group inline-block group-hover:cursor-pointer",
    size === "sm" ? "my-1 underline-offset-4" : "mx-1 my-3 underline-offset-8",
  ]}
>
  <a
    {href}
    transition:name={tag}
    class:list={[
      "relative inline-flex items-center gap-0.5 pe-2 text-lg text-muted-foreground transition-colors group-hover:text-accent",
      { "text-sm": size === "sm" },
    ]}
  >
    <IconHash
      class:list={[
        "inline-block shrink-0 opacity-70",
        { "size-4": size === "sm" },
        { "size-5": size === "lg" },
      ]}
    />
    <span>{tagName}</span>
  </a>
</li>
