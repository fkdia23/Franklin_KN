---
import {
  getLangFromUrl,
  localizePath,
  stripLang,
  useTranslations,
} from "@/i18n/utils";

export interface Props {
  /** Fil explicite (titres lisibles) ; sinon déduit de l'URL. */
  items?: { label: string; href?: string }[];
}

const { items } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Chemin sans préfixe de langue ni barre finale : /en/tags/llm/ → /tags/llm
const currentUrlPath = stripLang(Astro.url.pathname).replace(/\/+$/, "");

// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath.split("/").slice(1);

// Home > Posts > 1  =>  Home > Posts (page 1)
if (breadcrumbList[0] === "posts") {
  breadcrumbList.splice(
    0,
    2,
    `Posts (${t("page.of")} ${breadcrumbList[1] || 1})`
  );
}

// Home > Tags > [tag] > [page]  =>  Home > Tags > [tag] (page n)
if (breadcrumbList[0] === "tags" && !isNaN(Number(breadcrumbList[2]))) {
  breadcrumbList.splice(
    1,
    3,
    `${breadcrumbList[1]} ${Number(breadcrumbList[2]) === 1 ? "" : `(${t("page.of")} ${breadcrumbList[2]})`}`
  );
}

/** Libellé lisible des segments connus. */
const LABELS: Record<string, string> = {
  tags: t("nav.tags"),
  archives: t("nav.archives"),
  search: t("breadcrumb.search"),
  about: t("nav.about"),
};
---

<nav
  class="mx-auto mt-8 mb-1 w-full max-w-app px-4 text-sm text-muted-foreground"
  aria-label={t("breadcrumb.label")}
>
  <ul class="[&>li]:inline">
    <li>
      <a href={localizePath("/", lang)} class="hover:text-foreground"
        >{t("breadcrumb.home")}</a
      >
      <span aria-hidden="true" class="mx-1">/</span>
    </li>
    {
      items?.map((item, index) =>
        index + 1 === items.length || !item.href ? (
          <li>
            <span class="text-foreground" aria-current="page">
              {item.label}
            </span>
          </li>
        ) : (
          <li>
            <a href={item.href} class="hover:text-foreground">
              {item.label}
            </a>
            <span aria-hidden="true" class="mx-1">
              /
            </span>
          </li>
        )
      )
    }
    {
      !items &&
        breadcrumbList.map((breadcrumb, index) =>
          index + 1 === breadcrumbList.length ? (
            <li>
              <span
                class:list={[
                  "text-foreground",
                  { capitalize: index === 0, lowercase: index > 0 },
                ]}
                aria-current="page"
              >
                {LABELS[breadcrumb] ?? decodeURIComponent(breadcrumb)}
              </span>
            </li>
          ) : (
            <li>
              <a
                href={localizePath(`/${breadcrumb}/`, lang)}
                class="capitalize hover:text-foreground"
              >
                {LABELS[breadcrumb] ?? breadcrumb}
              </a>
              <span aria-hidden="true" class="mx-1">
                /
              </span>
            </li>
          )
        )
    }
  </ul>
</nav>
