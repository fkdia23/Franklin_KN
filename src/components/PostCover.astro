---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { categoriesFor } from "@/utils/categories";
import { getLangFromUrl } from "@/i18n/utils";

export interface Props {
  post: CollectionEntry<"blog">;
  /** Largeurs générées pour le srcset, et largeur affichée (attribut sizes). */
  widths: number[];
  sizes: string;
  alt?: string;
  loading?: "lazy" | "eager";
  class?: string;
}

const {
  post,
  widths,
  sizes,
  alt = "",
  loading = "lazy",
  class: className,
} = Astro.props;
const { cover, category, tags } = post.data;
const CATEGORIES = categoriesFor(getLangFromUrl(Astro.url));

/* ===== Couverture générée (post sans image) =====
 * Petit graphe de nœuds tiré d'un PRNG initialisé par le slug : chaque post
 * garde toujours le même motif, aux couleurs du thème (variables CSS). */
function random(seed: string) {
  let a = [...seed].reduce(
    (h, c) => Math.imul(h ^ c.charCodeAt(0), 16777619),
    2166136261
  );
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = random(post.id);
const nodes = Array.from({ length: 7 }, () => ({
  x: 168 + rand() * 128,
  y: 24 + rand() * 92,
}));
const edges = nodes.slice(1).map((node, i) => {
  const target = nodes[Math.floor(rand() * (i + 1))];
  return [node, target] as const;
});
const topic = tags[0] ?? CATEGORIES[category].label;
const others = tags.slice(1, 3);
const patternId = `cover-dots-${post.id}`;
---

{
  cover ? (
    <Image
      src={cover}
      {alt}
      {widths}
      {sizes}
      {loading}
      class:list={["object-cover object-top", className]}
    />
  ) : (
    <svg
      viewBox="0 0 320 180"
      preserveAspectRatio="xMidYMid slice"
      role={alt ? "img" : undefined}
      aria-label={alt || undefined}
      aria-hidden={alt ? undefined : "true"}
      class:list={["block", className]}
    >
      <defs>
        <pattern
          id={patternId}
          width="12"
          height="12"
          patternUnits="userSpaceOnUse"
        >
          <circle cx="1.5" cy="1.5" r="0.8" fill="var(--border)" />
        </pattern>
      </defs>
      <rect width="320" height="180" fill="var(--muted)" />
      <rect width="320" height="180" fill={`url(#${patternId})`} />
      <g stroke="var(--accent)" stroke-opacity="0.45" stroke-width="1.4">
        {edges.map(([a, b]) => (
          <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} />
        ))}
      </g>
      {nodes.map((node, i) => (
        <circle
          cx={node.x}
          cy={node.y}
          r={i === 0 ? 7 : 3.5}
          fill={i === 0 ? "var(--accent)" : "var(--background)"}
          stroke="var(--accent)"
          stroke-width="1.6"
        />
      ))}
      <text
        x="18"
        y="128"
        font-size="9"
        font-weight="700"
        letter-spacing="1.6"
        fill="var(--accent)"
      >
        {CATEGORIES[category].label.toUpperCase()}
      </text>
      <text
        x="16"
        y="156"
        font-size={topic.length > 11 ? 18 : 24}
        font-weight="700"
        fill="var(--foreground)"
      >
        {topic}
      </text>
      {others.length > 0 && (
        <text x="18" y="171" font-size="8.5" fill="var(--muted-foreground)">
          {others.map(tag => `#${tag}`).join("  ")}
        </text>
      )}
    </svg>
  )
}
