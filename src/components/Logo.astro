---
import { LOGO_GLYPHS, LOGO_RADIUS, LOGO_VIEWBOX } from "@/utils/logo";

export interface Props {
  /** Côté du monogramme en pixels. */
  size?: number;
  class?: string;
}

const { size = 36, class: className } = Astro.props;
---

<!-- Couleurs du thème (variables CSS --logo-badge / --logo-mark) -->
<svg
  viewBox={LOGO_VIEWBOX}
  width={size}
  height={size}
  aria-hidden="true"
  class:list={["shrink-0", className]}
>
  <rect width="128" height="128" rx={LOGO_RADIUS} fill="var(--logo-badge)"
  ></rect>
  <path fill="var(--logo-mark)" d={LOGO_GLYPHS}></path>
</svg>
