---
import { render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import ArticleScripts from "@/components/ArticleScripts.astro";
import PostCover from "@/components/PostCover.astro";
import { slugifyStr } from "@/utils/slugify";
import { categoriesFor } from "@/utils/categories";
import {
  getLocalizedPosts,
  getPostPath,
  getTranslation,
  postGroup,
} from "@/utils/translations";
import { localizePath, otherLang, useTranslations } from "@/i18n/utils";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";

export interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  category,
  lang,
  cover,
  coverAlt,
  github,
  huggingface,
  kaggle,
  demo,
} = post.data;

const { Content, headings, remarkPluginFrontmatter } = await render(post);

const readingTime = remarkPluginFrontmatter?.readingTime as number | undefined;

// L'interface suit la langue du post (son URL : /posts/… ou /en/posts/…)
const t = useTranslations(lang);
const CATEGORIES = categoriesFor(lang);

const translation = getTranslation(post, posts);
// Bouton de langue du header : la traduction, sinon la liste de l'autre langue
const alternate = translation
  ? getPostPath(translation)
  : localizePath("/posts/", otherLang(lang));

const projectLinks = [
  { label: t("post.github"), href: github },
  { label: t("post.huggingface"), href: huggingface },
  { label: t("post.kaggle"), href: kaggle },
  { label: t("post.demo"), href: demo },
].filter((l): l is { label: string; href: string } => Boolean(l.href));

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Aperçu généré (1200×630) si aucune image OG n'est fournie
const isGeneratedOgImage = !ogImageUrl && SITE.dynamicOgImage;
if (isGeneratedOgImage) {
  ogImageUrl = `${getPostPath(post)}/og.jpg`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.jpg`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  ogImageAlt: title,
  ogImageSize: isGeneratedOgImage ? { width: 1200, height: 630 } : undefined,
  ogType: "article" as const,
  lang,
  // hreflang : seulement si le post existe dans les deux langues
  alternates: translation
    ? {
        [lang]: getPostPath(post),
        [translation.data.lang]: getPostPath(translation),
      }
    : null,
  scrollSmooth: true,
};

/* ========== Prev/Next Posts ========== */
// Même ordre que la liste des posts de cette langue (une version par post)

const allPosts = getLocalizedPosts(posts, lang);

const currentPostIndex = allPosts.findIndex(
  p => postGroup(p) === postGroup(post)
);

const prevPost = currentPostIndex > 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex >= 0 ? (allPosts[currentPostIndex + 1] ?? null) : null;
---

<Layout {...layoutProps}>
  <Header {alternate} />
  <BackButton />
  <main
    id="main-content"
    class:list={[
      "mx-auto w-full max-w-app px-4 pb-12",
      { "mt-8": !SITE.showBackButton },
    ]}
    data-pagefind-body
  >
    {/* 1. L'image d'abord : couverture du post, ou couverture générée */}
    <figure class="overflow-hidden rounded-lg border border-border bg-muted">
      {
        cover ? (
          <Image
            src={cover}
            alt={coverAlt ?? ""}
            widths={[640, 960, 1280]}
            sizes="(min-width: 768px) 736px, 100vw"
            loading="eager"
            class="w-full"
          />
        ) : (
          <PostCover
            {post}
            widths={[640, 960]}
            sizes="(min-width: 768px) 736px, 100vw"
            class="aspect-video w-full"
          />
        )
      }
    </figure>

    {/* 2. Puis le grand titre, la description et les informations */}
    <p class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
      <a
        href={`${localizePath("/posts/", lang)}?categorie=${category}`}
        class="font-semibold tracking-wide text-accent uppercase hover:underline"
      >
        {CATEGORIES[category].label}
      </a>
      {
        translation && (
          <a
            href={getPostPath(translation)}
            hreflang={translation.data.lang}
            lang={translation.data.lang}
            class="text-sm text-muted-foreground transition-colors hover:text-accent"
          >
            {translation.data.lang === "en"
              ? "Read in English"
              : "Lire en français"}{" "}
            <span aria-hidden="true">→</span>
          </a>
        )
      }
    </p>
    <h1
      transition:name={slugifyStr(title)}
      class="mt-3 inline-block text-[2rem] leading-[1.12] font-bold tracking-tight sm:text-[2.75rem]"
    >
      {title}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted-foreground sm:text-xl">
      {description}
    </p>
    <div class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1">
      <Datetime {pubDatetime} {modDatetime} {timezone} {lang} size="lg" />
      {
        readingTime && (
          <>
            <span aria-hidden="true" class="text-muted-foreground">
              ·
            </span>
            <span class="text-sm text-muted-foreground">
              {readingTime} {t("post.minRead")}
            </span>
          </>
        )
      }
    </div>
    {
      projectLinks.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2">
          {projectLinks.map(link => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary py-1.5"
            >
              {link.label}
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      )
    }

    {/* Sommaire repliable — petits écrans */}
    <details
      class="group mt-6 rounded-md border border-border bg-muted/30 px-4 py-3 min-[1340px]:hidden"
    >
      <summary
        class="cursor-pointer list-none text-sm font-semibold tracking-wide text-foreground uppercase select-none"
      >
        {t("toc.title")}
      </summary>
      <div class="mt-3">
        <TableOfContents {headings} heading={false} />
      </div>
    </details>

    <div class="relative">
      <article
        id="article"
        class="app-prose mx-auto mt-8 max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
      >
        <Content />
      </article>

      {/* Sommaire vertical sticky — grands écrans */}
      <aside
        class="absolute start-full top-0 hidden h-full ps-8 min-[1340px]:block"
      >
        <div class="sticky top-20 w-56">
          <TableOfContents {headings} />
        </div>
      </aside>
    </div>

    <hr class="my-8 border-border" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <ul class="mt-4 mb-8 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} />)}
    </ul>

    <BackToTopButton />

    <!-- <ShareLinks /> -->
    <!-- 
    <hr class="my-6 border-dashed" /> -->

    <!-- Previous/Next Post Buttons -->
    <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        prevPost && (
          <a
            href={getPostPath(prevPost)}
            class="flex w-full gap-1 hover:opacity-75"
          >
            <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
            <div>
              <span>{t("post.prev")}</span>
              <div class="text-sm text-accent/85">{prevPost.data.title}</div>
            </div>
          </a>
        )
      }
      {
        nextPost && (
          <a
            href={getPostPath(nextPost)}
            class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
          >
            <div>
              <span>{t("post.next")}</span>
              <div class="text-sm text-accent/85">{nextPost.data.title}</div>
            </div>
            <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
          </a>
        )
      }
    </div>
  </main>
  <Footer />
</Layout>

<ArticleScripts />
