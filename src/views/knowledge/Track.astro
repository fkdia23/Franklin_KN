---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import CourseCard from "@/components/knowledge/CourseCard.astro";
import EntryList from "@/components/knowledge/EntryList.astro";
import ProgressBars from "@/components/knowledge/ProgressBars.astro";
import DevNotice from "@/components/knowledge/DevNotice.astro";
import { getLocalizedPosts, postGroup } from "@/utils/translations";
import {
  sectionsFor,
  SECTION_KEYS,
  hubUrl,
  trackUrl,
  type TrackData,
} from "@/utils/knowledge";
import { KNOWLEDGE } from "@/knowledge.config";
import { SITE } from "@/config";
import { getLangFromUrl, stripLang, useTranslations } from "@/i18n/utils";

const { data } = Astro.props as { data: TrackData };
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const SECTIONS = sectionsFor(lang);
const { track, overview, courses, sections, progress } = data;
const base = trackUrl(track, lang);

const Overview = overview ? (await render(overview)).Content : null;

// Posts du blog liés au track (publiés uniquement)
const relatedIds = overview?.data.related ?? [];
const relatedPosts = relatedIds.length
  ? getLocalizedPosts(await getCollection("blog"), lang).filter(post =>
      relatedIds.includes(postGroup(post))
    )
  : [];

/** Nombre d'éléments affichés par section avant « Tout voir ». */
const PREVIEW_COUNT = 5;
const filled = SECTION_KEYS.filter(key => sections[key].length > 0);

// Sommaire de la page : uniquement les sections qui ont du contenu
const anchors = [
  ...(Overview ? [{ id: "overview", label: t("k.overview") }] : []),
  ...(courses.length ? [{ id: "courses", label: t("k.courses") }] : []),
  ...filled.map(key => ({ id: key, label: SECTIONS[key].label })),
  ...(relatedPosts.length ? [{ id: "related", label: t("k.related") }] : []),
];

const heading = "mb-4 text-xl font-semibold tracking-tight";

// Aperçu de lien généré par src/pages/knowledge/[...page]/og.jpg.ts
// (une seule image par page, partagée par le français et l'anglais)
const ogImage = `${stripLang(Astro.url.pathname).replace(/\/?$/, "/")}og.jpg`;
const ogImageSize = { width: 1200, height: 630 };
---

<Layout
  title={`${track.title} | ${SITE.title}`}
  description={data.description || t("k.description")}
  {ogImage}
  {ogImageSize}
>
  <Header />
  <Breadcrumb
    items={[
      { label: KNOWLEDGE.title, href: hubUrl(lang) },
      { label: track.title },
    ]}
  />
  <main
    id="main-content"
    class="mx-auto w-full max-w-app px-4 pt-4 pb-16"
    data-pagefind-body={track.enabled ? "" : undefined}
  >
    <DevNotice show={!track.enabled}>
      {t("k.devTrack")}
    </DevNotice>

    <h1
      class="text-[2rem] leading-tight font-bold tracking-tight sm:text-[2.6rem]"
    >
      {track.title}
    </h1>
    {
      data.description && (
        <p class="mt-3 text-lg leading-relaxed text-muted-foreground sm:text-xl">
          {data.description}
        </p>
      )
    }

    {
      progress.length > 0 && (
        <div
          class="mt-8 rounded-lg border border-border p-5"
          aria-labelledby="progress"
        >
          <h2
            id="progress"
            class="mb-4 text-xs font-semibold tracking-wide text-muted-foreground uppercase"
          >
            {t("k.progress")}
          </h2>
          <ProgressBars rows={progress} color={track.color} />
        </div>
      )
    }

    {
      anchors.length > 1 && (
        <nav aria-label={t("k.sections")} class="mt-8">
          <ul class="flex flex-wrap gap-2 text-sm">
            {anchors.map(anchor => (
              <li>
                <a
                  href={`#${anchor.id}`}
                  class="inline-block rounded-md border border-border px-3 py-1 text-muted-foreground transition-colors hover:border-accent hover:text-accent"
                >
                  {anchor.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      Overview && (
        <div id="overview" class="app-prose mt-8">
          <Overview />
        </div>
      )
    }

    {
      data.isEmpty && (
        <p class="mt-10 rounded-lg border border-border px-5 py-6 text-center text-muted-foreground">
          {t("k.empty")}
        </p>
      )
    }

    {
      courses.length > 0 && (
        <div id="courses" class="mt-12">
          <h2 class={heading}>{t("k.courses")}</h2>
          <ul class="grid gap-4 sm:grid-cols-2">
            {courses.map(course => (
              <CourseCard {course} />
            ))}
          </ul>
        </div>
      )
    }

    {
      filled.map(key => (
        <div id={key} class="mt-12">
          <div class="mb-4 flex items-baseline justify-between gap-4">
            <h2 class="text-xl font-semibold tracking-tight">
              {SECTIONS[key].label}
            </h2>
            {sections[key].length > PREVIEW_COUNT && (
              <a
                href={`${base}${key}/`}
                class="text-sm font-medium text-accent hover:underline"
              >
                {t("k.seeAll")} ({sections[key].length})
              </a>
            )}
          </div>
          <EntryList items={sections[key].slice(0, PREVIEW_COUNT)} />
        </div>
      ))
    }

    {
      relatedPosts.length > 0 && (
        <div id="related" class="mt-12">
          <h2 class={heading}>{t("k.related")}</h2>
          <ul>
            {relatedPosts.map(post => (
              <Card {post} variant="h3" />
            ))}
          </ul>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>
